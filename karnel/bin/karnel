#!/data/data/com.termux/files/usr/bin/env bash

SOURCE="${BASH_SOURCE[0]}"

# resolver symlink si existe
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done

BIN_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"

# root del proyecto
KARNEL_PATH="$(cd "$BIN_DIR/.." 2>/dev/null && pwd)" || {
  echo "Error: Could not determine KARNEL_PATH from $BIN_DIR/.." >&2
  exit 1
}

# cargar bootstrap
source "$KARNEL_PATH/utils/bootstrap.sh"

# --auto is global and may be supplied before or after the command. Remove it
# before dispatch because module lifecycle parsers treat every --flag as a tool.
_karnel_args=()
for _karnel_arg in "$@"; do
  if [[ "$_karnel_arg" == "--auto" ]]; then
    export KARNEL_AUTO=1
    export KARNEL_NONINTERACTIVE=1
    export KARNEL_REMOVE_DEFAULT=y
  else
    _karnel_args+=("$_karnel_arg")
  fi
done
set -- "${_karnel_args[@]}"

# Informational flags must not initialize user state or trigger update checks.
case "${1:-}" in
  --help|-h|--version|help|version|list|show|search|stats|status) KARNEL_READ_ONLY=1 ;;
esac

# cargar entorno
import "@/utils/env"

# ===== SEMVER COMPARISON =====
_semver_gt() {
  local a="${1#v}" b="${2#v}"
  [[ "$(printf '%s\n%s' "$a" "$b" | sort -V | tail -1)" == "$a" ]] && [[ "$a" != "$b" ]]
}

_valid_semver() {
  [[ "$1" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+([+-][0-9A-Za-z.-]+)?$ ]]
}

# ===== CHECK UPDATES =====
check_for_updates() {
  local version_file="$KARNEL_CACHE/last_version_check"
  local current_time
  current_time=$(date +%s)
  local check_interval=86400  # 24 horas en segundos
  local last_check=0

  if [[ -f "$version_file" ]]; then
    last_check=$(cat "$version_file" 2>/dev/null | head -1)
  fi

  if [[ "$last_check" =~ ^[0-9]+$ ]] && (( current_time - last_check < check_interval )); then
    return 0
  fi

  (
    local lock_dir="$KARNEL_CACHE/.version_check.lock"
    local remote_output remote_version timestamp_tmp

    _karnel_acquire_lock "$lock_dir" || return 0
    _cleanup_version_lock() { _karnel_release_lock "$lock_dir" 2>/dev/null || true; }
    trap _cleanup_version_lock EXIT

    last_check=0
    if [[ -f "$version_file" ]]; then
      read -r last_check < "$version_file" || last_check=0
    fi
    if [[ "$last_check" =~ ^[0-9]+$ ]] && (( current_time - last_check < check_interval )); then
      return 0
    fi

    remote_version=""
    if remote_output=$(timeout 5 npm view karnel-termux version 2>/dev/null); then
      remote_version=$(printf '%s\n' "$remote_output" | tail -1)
    fi
    if ! _valid_semver "$remote_version"; then
      remote_version=""
      if remote_output=$(curl -fsSL --max-time 5 "https://raw.githubusercontent.com/israelmarques1024-dotcom/karnel-termux/main/package.json" 2>/dev/null); then
        remote_version=$(printf '%s\n' "$remote_output" | sed -nE 's/^[[:space:]]*"version":[[:space:]]*"([^"]+)".*/\1/p' | head -1)
      fi
    fi
    _valid_semver "$remote_version" || return 0

    local local_version="$KARNEL_VERSION"
    if _semver_gt "$remote_version" "$local_version"; then
      echo "$remote_version" > "$KARNEL_CACHE/new_version"
    else
      rm -f "$KARNEL_CACHE/new_version"
    fi

    timestamp_tmp=$(mktemp "$KARNEL_CACHE/.last_version_check.XXXXXX") || return 0
    if ! printf '%s\n' "$current_time" > "$timestamp_tmp" || ! mv -f "$timestamp_tmp" "$version_file"; then
      rm -f "$timestamp_tmp"
    fi
  ) &>/dev/null &
  local check_pid=$!
  if [[ "${KARNEL_UPDATE_CHECK_WAIT:-0}" == "1" ]]; then
    wait "$check_pid"
  fi
}

show_update_notification() {
  local new_version_file="$KARNEL_CACHE/new_version"
  if [[ -f "$new_version_file" ]]; then
    local new_version
    new_version=$(cat "$new_version_file")
    if ! _semver_gt "$new_version" "$KARNEL_VERSION"; then
      rm -f "$new_version_file"
      return 0
    fi
    echo
    separator_section "Update Available"
    echo
    log_warn "New version available: ${D_GREEN}$new_version${D_NC} (current: ${D_CYAN}$KARNEL_VERSION${D_NC})"
    echo
    list_item "Run: ${D_CYAN}karnel update karnel${D_NC} to update"
    echo
  fi
}

if [[ "${KARNEL_READ_ONLY:-0}" != "1" ]] && [[ "${1:-}" != "update" ]] && [[ "${1:-}" != "uninstall" ]] && [[ "${1:-}" != "reinstall" ]] && [[ "${1:-}" != "upgrade" ]]; then
  check_for_updates
  import "@/utils/log"
  import "@/utils/colors"
  show_update_notification
fi

# cargar CLI unificado (com TUI + help)
import "@/cli/karnel"

if [[ "${KARNEL_AUTO:-0}" == "1" && $# -eq 0 ]]; then
  karnel_help
  exit 0
fi

karnel_main "$@"
