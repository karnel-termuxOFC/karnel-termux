{
  "name": "karnel-termux",
  "version": "4.17.44",
  "description": "Modular Dev Environment for Termux — install languages, databases, AI agents, editors, and more with one command",
  "bin": {
    "karnel": "karnel/bin/karnel"
  },
  "files": [
    "karnel/",
    "assets/fonts/font.ttf",
    "scripts/",
    "docs/",
    "install.sh",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check:syntax": "bash tests/check-syntax.sh",
    "lint:shell": "bash tests/check-shellcheck.sh",
    "test": "bash tests/run-isolated.sh",
    "pack:check": "node scripts/check-package.js",
    "release": "node scripts/publish.js",
    "ci": "npm run lint:shell && npm test && npm run pack:check",
    "postinstall": "node scripts/npm-install.js"
  },
  "engines": {
    "node": ">=16.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/israelmarques1024-dotcom/karnel-termux.git"
  },
  "keywords": [
    "termux",
    "dev-environment",
    "cli",
    "modular",
    "android",
    "developer-tools"
  ],
  "author": "israel marques",
  "contributors": [
    "israel marques"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/israelmarques1024-dotcom/karnel-termux/issues"
  },
  "homepage": "https://karneltermux.vercel.app"
}
